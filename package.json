{
  "name": "claude-code-dashboard",
  "private": true,
  "version": "2.3.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c magenta,cyan \"vite\" \"node --watch server/index.js\"",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:server && npm run test:ui",
    "test:server": "bash tests/run-all.sh",
    "test:ui": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "server": "node server/index.js",
    "build:edge": "node scripts/build-edge.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-athena": "^3.675.0",
    "@aws-sdk/client-bedrock-runtime": "^3.675.0",
    "@aws-sdk/client-s3": "^3.675.0",
    "@aws-sdk/client-secrets-manager": "^3.1037.0",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "multer": "^2.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.13.3",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.4",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
